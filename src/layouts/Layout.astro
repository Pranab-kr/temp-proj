---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "QuickyIT - Fast Digital Services & TANZZZX Studio | ReachX Group",
  description = "On-demand digital services for business owners: Websites, Apps, Branding, Marketing & Real Estate 3D Walkthroughs. Quick booking with instant WhatsApp connection."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#52c41a" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Rubik:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <style>
      :root {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      }
      .font-display {
        font-family: 'Outfit', sans-serif;
      }
      .font-heading {
        font-family: 'Rubik', sans-serif;
      }
    </style>
  </head>
  <body class="bg-slate-100 text-slate-900 antialiased min-h-screen selection:bg-lime-400 selection:text-slate-900">
    <slot />
  </body>
</html>
