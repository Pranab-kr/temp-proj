---
import Icon from './Icon.astro';
---

<footer class="mt-12 bg-white border-t border-slate-200 text-slate-700">
  <!-- Value Props / Trust Indicators -->
  <div class="max-w-7xl mx-auto px-4 py-8 border-b border-slate-100">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 text-center sm:text-left">
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
          <Icon name="zap" class="w-5 h-5 text-emerald-600" />
        </div>
        <div>
          <h5 class="text-xs font-black text-slate-900 uppercase tracking-wider">Fast 48H Sprint</h5>
          <p class="text-[11px] text-slate-500 mt-0.5">Quick delivery model for business owners on strict timelines.</p>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-3">
        <div class="w-10 h-10 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
          <Icon name="whatsapp" class="w-5 h-5 text-blue-600" />
        </div>
        <div>
          <h5 class="text-xs font-black text-slate-900 uppercase tracking-wider">Direct Admin Chat</h5>
          <p class="text-[11px] text-slate-500 mt-0.5">Instant WhatsApp connection with zero intermediary delay.</p>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-3">
        <div class="w-10 h-10 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
          <Icon name="shield-check" class="w-5 h-5 text-amber-600" />
        </div>
        <div>
          <h5 class="text-xs font-black text-slate-900 uppercase tracking-wider">Transparent Pricing</h5>
          <p class="text-[11px] text-slate-500 mt-0.5">Clear starting rates with exact scope locked upfront on call.</p>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-3">
        <div class="w-10 h-10 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center shrink-0">
          <Icon name="award" class="w-5 h-5 text-purple-600" />
        </div>
        <div>
          <h5 class="text-xs font-black text-slate-900 uppercase tracking-wider">Tanzzzx 3D Studio</h5>
          <p class="text-[11px] text-slate-500 mt-0.5">Cinematic 4K real estate walkthroughs & digital brochures.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      
      <!-- Brand & Subtitle -->
      <div class="space-y-2 text-center md:text-left">
        <div class="flex items-center justify-center md:justify-start gap-2">
          <img src="/logo2 transparent.png" alt="QuickyIT" class="h-7 w-auto object-contain" />
          <span class="font-display font-black text-lg tracking-tight text-slate-900">QuickyIT</span>
          <span class="text-slate-300">×</span>
          <span class="font-display font-extrabold text-sm tracking-wider text-slate-700 uppercase">TANZZZX STUDIO</span>
        </div>
        <p class="text-xs text-slate-500 max-w-md">
          On-demand digital commerce services for every business owner. Fast website builds, mobile apps, marketing sprints, and luxury 3D architectural marketing.
        </p>
      </div>

      <!-- Quick Actions -->
      <div class="flex flex-wrap items-center justify-center gap-3">
        <button 
          onclick="document.getElementById('open-consultancy-modal').click()" 
          class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition shadow-sm"
        >
          Book Free Consultation
        </button>

        <a 
          href="https://wa.me/919876543210?text=Hello%20Admin,%20I%20am%20inquiring%20about%20your%20services." 
          target="_blank" 
          rel="noopener noreferrer"
          class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition flex items-center gap-1.5"
        >
          <Icon name="whatsapp" class="w-3.5 h-3.5 text-emerald-400" />
          <span>Chat on WhatsApp</span>
        </a>
      </div>

    </div>

    <!-- Bottom ReachX Unit Attribution (As requested: "write in small as a reachx group unit") -->
    <div class="mt-8 pt-6 border-t border-slate-200/80 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
      <div class="text-[11px] text-slate-500 font-medium">
        © 2026 QuickyIT & TANZZZX Studio. All rights reserved.
      </div>

      <!-- Small ReachX Group Unit Badge -->
      <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100 border border-slate-200 text-[10px] text-slate-600 font-bold">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="tracking-wide uppercase text-slate-500">A</span>
        <span class="tracking-wider uppercase text-slate-900 font-black">ReachX Group Unit</span>
      </div>
    </div>
  </div>
</footer>
