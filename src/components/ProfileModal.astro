---
import Icon from './Icon.astro';
---

<!-- Profile & Account Drawer -->
<div id="profile-drawer-backdrop" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs transition-opacity duration-300 opacity-0 pointer-events-none">
  <div 
    id="profile-drawer-panel" 
    class="fixed inset-y-0 right-0 max-w-sm w-full bg-white shadow-2xl flex flex-col justify-between transform translate-x-full transition-transform duration-300 ease-out z-50 overflow-hidden"
  >
    <!-- Drawer Header -->
    <div class="p-5 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-emerald-500 to-blue-500 text-white flex items-center justify-center font-display font-black text-lg shadow-md">
          Q
        </div>
        <div>
          <h3 class="font-display font-black text-slate-900 text-base leading-tight">My Business Hub</h3>
          <p class="text-[11px] text-slate-500 font-medium">QuickyIT Customer Portal</p>
        </div>
      </div>

      <button 
        id="close-profile-drawer-btn" 
        class="w-8 h-8 rounded-full bg-slate-200/60 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition active:scale-95"
        aria-label="Close profile"
      >
        <Icon name="x" class="w-4 h-4" />
      </button>
    </div>

    <!-- Drawer Body -->
    <div class="p-5 space-y-5 flex-1 overflow-y-auto no-scrollbar">
      
      <!-- Quick Status Card -->
      <div class="p-4 rounded-2xl bg-gradient-to-r from-emerald-50 to-teal-50 border border-emerald-200/70 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-bold text-emerald-800 uppercase tracking-wider">Active Client Status</span>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-600 text-white">Verified</span>
        </div>
        <p class="text-xs text-slate-700 font-medium">
          Instant priority WhatsApp support enabled for your phone number.
        </p>
      </div>

      <!-- Quick Action Links -->
      <div class="space-y-2">
        <a 
          href="https://wa.me/919876543210?text=Hello%20QuickyIT,%20I%20want%20to%20check%20my%20service%20inquiry%20status." 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center justify-between p-3 rounded-xl border border-slate-200 hover:border-emerald-300 hover:bg-slate-50 transition group"
        >
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center">
              <Icon name="message-circle" class="w-4 h-4" />
            </div>
            <div class="text-left">
              <div class="text-xs font-bold text-slate-800 group-hover:text-emerald-700">Track Inquiries & Orders</div>
              <div class="text-[10px] text-slate-400">Live WhatsApp status updates</div>
            </div>
          </div>
          <Icon name="chevron-right" class="w-4 h-4 text-slate-400" />
        </a>

        <button 
          id="profile-open-consultancy-btn" 
          class="w-full flex items-center justify-between p-3 rounded-xl border border-slate-200 hover:border-emerald-300 hover:bg-slate-50 transition group text-left"
        >
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center">
              <Icon name="calendar" class="w-4 h-4" />
            </div>
            <div>
              <div class="text-xs font-bold text-slate-800 group-hover:text-blue-700">Book Free Strategy Call</div>
              <div class="text-[10px] text-slate-400">Talk to solutions director</div>
            </div>
          </div>
          <Icon name="chevron-right" class="w-4 h-4 text-slate-400" />
        </button>

        <a 
          href="tel:+919876543210" 
          class="flex items-center justify-between p-3 rounded-xl border border-slate-200 hover:border-emerald-300 hover:bg-slate-50 transition group"
        >
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center">
              <Icon name="phone" class="w-4 h-4" />
            </div>
            <div class="text-left">
              <div class="text-xs font-bold text-slate-800 group-hover:text-amber-700">Direct Helpline</div>
              <div class="text-[10px] text-slate-400">+91 98765 43210</div>
            </div>
          </div>
          <Icon name="chevron-right" class="w-4 h-4 text-slate-400" />
        </a>
      </div>

      <!-- About ReachX Group Unit -->
      <div class="p-4 rounded-2xl bg-slate-900 text-white space-y-2">
        <div class="text-[10px] font-extrabold uppercase tracking-widest text-emerald-400">About Our Company</div>
        <h4 class="font-display font-bold text-sm text-white">QuickyIT & TANZZZX Studio</h4>
        <p class="text-[11px] text-slate-300 leading-relaxed">
          Proud unit of <strong>ReachX Group</strong>. We deliver high-speed digital services, enterprise applications, and cinematic 3D architectural marketing for builders and enterprises globally.
        </p>
        <div class="pt-2 border-t border-slate-800 flex items-center justify-between text-[10px] text-slate-400">
          <span>Headquarters: Kolkata, India</span>
          <span class="text-emerald-400 font-bold">● Operations Active</span>
        </div>
      </div>

    </div>

    <!-- Drawer Footer -->
    <div class="p-4 border-t border-slate-200 bg-slate-50 text-center text-[10px] text-slate-400 space-y-1">
      <div>QuickyIT Web App v2.4 • ReachX Group Unit</div>
      <div>Designed for instant phone interface</div>
    </div>
  </div>
</div>
