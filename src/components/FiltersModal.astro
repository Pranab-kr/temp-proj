---
import Icon from './Icon.astro';
---

<!-- Filters Modal / Bottom Sheet -->
<div id="filters-modal-backdrop" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs transition-opacity duration-300 opacity-0 pointer-events-none flex items-center justify-center p-3 sm:p-4">
  <div 
    id="filters-modal-card" 
    class="bg-white rounded-3xl max-w-sm w-full shadow-2xl border border-slate-200 overflow-hidden transform scale-95 transition-transform duration-300 ease-out p-5 space-y-4"
  >
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <div class="flex items-center gap-2">
        <Icon name="sliders-horizontal" class="w-5 h-5 text-emerald-600" />
        <h3 class="font-display font-black text-slate-900 text-base leading-tight">Filter Services</h3>
      </div>

      <button 
        id="close-filters-modal-btn" 
        class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition active:scale-95"
        aria-label="Close filters"
      >
        <Icon name="x" class="w-4 h-4" />
      </button>
    </div>

    <!-- Filter Options -->
    <div class="space-y-4">
      <!-- Sort By -->
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-2">Sort By</label>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <button class="filter-sort-btn p-2.5 rounded-xl border border-emerald-500 bg-emerald-50 font-bold text-emerald-800 text-left transition" data-sort="popular">
            🔥 Most Popular
          </button>
          <button class="filter-sort-btn p-2.5 rounded-xl border border-slate-200 bg-white font-medium text-slate-700 text-left hover:bg-slate-50 transition" data-sort="price_low">
            💰 Price: Low to High
          </button>
          <button class="filter-sort-btn p-2.5 rounded-xl border border-slate-200 bg-white font-medium text-slate-700 text-left hover:bg-slate-50 transition" data-sort="price_high">
            💎 Price: High to Low
          </button>
          <button class="filter-sort-btn p-2.5 rounded-xl border border-slate-200 bg-white font-medium text-slate-700 text-left hover:bg-slate-50 transition" data-sort="rating">
            ⭐ Highest Rated
          </button>
        </div>
      </div>

      <!-- Turnaround Speed -->
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-2">Delivery Speed</label>
        <div class="space-y-1.5">
          <label class="flex items-center gap-2 p-2 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer text-xs font-medium text-slate-800">
            <input type="radio" name="speed_filter" value="all" checked class="text-emerald-600 focus:ring-emerald-500" />
            <span>Show All Delivery Speeds</span>
          </label>
          <label class="flex items-center gap-2 p-2 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer text-xs font-medium text-slate-800">
            <input type="radio" name="speed_filter" value="sprint48h" class="text-emerald-600 focus:ring-emerald-500" />
            <span class="flex items-center gap-1 font-bold text-emerald-700">
              <Icon name="zap" class="w-3.5 h-3.5 text-emerald-600" />
              48-Hour Sprint Deliveries Only
            </span>
          </label>
        </div>
      </div>
    </div>

    <!-- Apply & Reset Buttons -->
    <div class="pt-3 border-t border-slate-100 flex items-center gap-2">
      <button 
        id="reset-filters-btn" 
        class="w-1/3 py-2.5 rounded-xl border border-slate-200 text-xs font-bold text-slate-600 hover:bg-slate-50 transition active:scale-95"
      >
        Reset
      </button>
      <button 
        id="apply-filters-btn" 
        class="w-2/3 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-xs font-bold text-white shadow-md shadow-emerald-600/20 transition active:scale-95"
      >
        Apply Filters
      </button>
    </div>
  </div>
</div>
