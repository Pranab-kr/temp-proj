---
import Icon from './Icon.astro';
---

<!-- Free Consultancy Modal -->
<div id="consultancy-modal-backdrop" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs transition-opacity duration-300 opacity-0 pointer-events-none flex items-center justify-center p-3 sm:p-4">
  <div 
    id="consultancy-modal-card" 
    class="bg-white rounded-3xl max-w-md w-full shadow-2xl border border-slate-200 overflow-hidden transform scale-95 transition-transform duration-300 ease-out"
  >
    <!-- Modal Header -->
    <div class="px-5 py-4 bg-gradient-to-r from-emerald-600 to-green-600 text-white flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-white/20 backdrop-blur-sm flex items-center justify-center">
          <Icon name="calendar" class="w-5 h-5 text-white" />
        </div>
        <div>
          <h3 class="font-display font-black text-base leading-tight">Schedule Free Consultancy</h3>
          <p class="text-[11px] text-emerald-100 font-medium">1-on-1 Strategy Call with Senior Solutions Architect</p>
        </div>
      </div>

      <button 
        id="close-consultancy-modal-btn" 
        class="w-8 h-8 rounded-full bg-white/20 hover:bg-white/30 text-white flex items-center justify-center transition active:scale-95"
        aria-label="Close modal"
      >
        <Icon name="x" class="w-4 h-4" />
      </button>
    </div>

    <!-- Modal Form -->
    <form id="consultancy-form" class="p-5 space-y-3.5">
      <div class="p-2.5 bg-emerald-50 rounded-xl border border-emerald-200 text-xs text-emerald-800 flex items-center gap-2">
        <Icon name="shield-check" class="w-4 h-4 text-emerald-600 shrink-0" />
        <span>100% Free Consultation. No obligation. Direct WhatsApp Confirmation.</span>
      </div>

      <!-- Service Interest -->
      <div>
        <label for="cons-service" class="block text-xs font-bold text-slate-700 mb-1">
          Service or Project of Interest
        </label>
        <select 
          id="cons-service" 
          class="w-full px-3 py-2.5 text-xs rounded-xl border border-slate-200 bg-white focus:border-emerald-500 focus:outline-none font-medium"
        >
          <option value="Website & Web Application">🌐 Website & Web Application</option>
          <option value="E-commerce Store (Next.js / Shopify)">🛍️ E-Commerce Website & Checkout</option>
          <option value="Android / iOS Mobile App">📱 Android & iOS Mobile App</option>
          <option value="ERP / CRM Custom Automation">🏢 ERP / CRM Software Automation</option>
          <option value="Brand Identity, Logo & Graphics">🎨 Brand Identity & Graphic Suite</option>
          <option value="Video Editing & Commercials">🎬 Video Production & Ads</option>
          <option value="Meta & Google Performance Paid Ads">🎯 Paid Ads (Meta & Google)</option>
          <option value="Tanzzzx: 3D Architectural Walkthrough (2-3 Min)">🏢 Tanzzzx: 3D Real Estate Walkthrough</option>
          <option value="Tanzzzx: Digital & Physical Brochure">📑 Tanzzzx: Real Estate Brochures & 3D Plans</option>
          <option value="Tanzzzx: Real Estate Drone Shoot & Ads">🚁 Tanzzzx: Real Estate Drone & Ads Shoot</option>
          <option value="Tanzzzx: Total Real Estate Launch Bundle">🏆 Tanzzzx: Total Real Estate Launch Suite</option>
        </select>
      </div>

      <!-- Name -->
      <div>
        <label for="cons-name" class="block text-xs font-bold text-slate-700 mb-1">
          Your Name <span class="text-rose-500">*</span>
        </label>
        <input 
          type="text" 
          id="cons-name" 
          placeholder="e.g. Vikram Singhania" 
          required 
          class="w-full px-3 py-2.5 text-xs rounded-xl border border-slate-200 focus:border-emerald-500 focus:outline-none"
        />
      </div>

      <!-- WhatsApp Phone -->
      <div>
        <label for="cons-phone" class="block text-xs font-bold text-slate-700 mb-1">
          WhatsApp Phone Number <span class="text-rose-500">*</span>
        </label>
        <div class="flex rounded-xl border border-slate-200 overflow-hidden focus-within:border-emerald-500">
          <span class="bg-slate-100 text-slate-600 px-3 py-2 text-xs font-semibold flex items-center border-r border-slate-200">
            🇮🇳 +91
          </span>
          <input 
            type="tel" 
            id="cons-phone" 
            placeholder="98765 43210" 
            required 
            class="w-full px-3 py-2 text-xs focus:outline-none"
          />
        </div>
      </div>

      <!-- Preferred Slot & City -->
      <div class="grid grid-cols-2 gap-2">
        <div>
          <label for="cons-city" class="block text-xs font-bold text-slate-700 mb-1">City</label>
          <input 
            type="text" 
            id="cons-city" 
            value="Kolkata" 
            class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none"
          />
        </div>
        <div>
          <label for="cons-slot" class="block text-xs font-bold text-slate-700 mb-1">Preferred Time</label>
          <select 
            id="cons-slot" 
            class="w-full px-2.5 py-2 text-xs rounded-xl border border-slate-200 bg-white focus:outline-none font-medium"
          >
            <option value="Urgent (Within 15-30 Mins)">⚡ Urgent (15-30 Mins)</option>
            <option value="Morning (10:00 AM - 1:00 PM)">🌅 Morning (10 AM - 1 PM)</option>
            <option value="Afternoon (2:00 PM - 5:00 PM)" selected>☀️ Afternoon (2 PM - 5 PM)</option>
            <option value="Evening (6:00 PM - 9:00 PM)">🌙 Evening (6 PM - 9 PM)</option>
          </select>
        </div>
      </div>

      <!-- Additional Details -->
      <div>
        <label for="cons-notes" class="block text-xs font-bold text-slate-700 mb-1">What would you like to achieve?</label>
        <textarea 
          id="cons-notes" 
          rows="2" 
          placeholder="Brief description of your business or requirements..." 
          class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:border-emerald-500 focus:outline-none"
        ></textarea>
      </div>

      <!-- Submit Button -->
      <button 
        type="submit" 
        class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-emerald-600 to-green-600 hover:from-emerald-700 text-white font-extrabold text-xs sm:text-sm shadow-md shadow-emerald-600/20 flex items-center justify-center gap-2 transition active:scale-95"
      >
        <Icon name="whatsapp" class="w-4 h-4 text-white" />
        <span>Confirm & Schedule on WhatsApp 💬</span>
      </button>

      <p class="text-[10px] text-center text-slate-400 font-medium">
        Redirects directly to WhatsApp chat with QuickyIT admin.
      </p>
    </form>
  </div>
</div>
