---
import Icon from './Icon.astro';
import { OFFERS } from '../data/services';
---

<div class="px-3 sm:px-6 max-w-7xl mx-auto my-1">
  <div class="relative overflow-hidden rounded-2xl shadow-sm border border-slate-200/80 bg-slate-900 text-white">
    <!-- Carousel Slider Track -->
    <div id="offers-carousel-track" class="flex transition-transform duration-500 ease-out">
      {OFFERS.map((offer, idx) => (
        <div 
          class="offer-slide w-full shrink-0 relative p-4 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
          data-brand={offer.brand}
        >
          <!-- Background Glow Accent -->
          <div class={`absolute inset-0 bg-gradient-to-r ${offer.gradient} opacity-90`}></div>
          <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>

          <!-- Content -->
          <div class="relative z-10 max-w-xl">
            <div class="flex items-center gap-2 mb-1.5">
              <span class="inline-flex items-center gap-1 bg-black/30 backdrop-blur-md px-2 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wider text-white border border-white/20">
                <Icon name="sparkles" class="w-3 h-3 text-yellow-300" />
                {offer.tag}
              </span>
              <span class="text-[11px] font-semibold text-white/80 bg-white/15 px-2 py-0.5 rounded font-mono">
                CODE: <strong class="text-white underline decoration-yellow-400">{offer.code}</strong>
              </span>
            </div>

            <h3 class="font-display font-black text-lg sm:text-2xl text-white tracking-tight leading-tight">
              {offer.title}
            </h3>
            <p class="text-xs sm:text-sm text-white/90 font-medium mt-1">
              {offer.description}
            </p>
          </div>

          <!-- Banner Action Button -->
          <div class="relative z-10 shrink-0 w-full sm:w-auto flex items-center justify-between sm:justify-end gap-3">
            <button 
              class="banner-cta-btn w-full sm:w-auto px-4 py-2.5 rounded-xl bg-white text-slate-900 hover:bg-slate-100 text-xs sm:text-sm font-extrabold shadow-lg shadow-black/20 transition active:scale-95 flex items-center justify-center gap-1.5"
              data-brand={offer.brand}
              data-code={offer.code}
            >
              <span>{offer.cta}</span>
              <Icon name="arrow-right" class="w-4 h-4 text-emerald-600" />
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- Carousel Dots Indicators & Controls -->
    <div class="absolute bottom-2 right-4 z-20 flex items-center gap-1.5">
      {OFFERS.map((_, i) => (
        <button 
          class={`carousel-dot w-2 h-2 rounded-full transition-all ${i === 0 ? 'w-5 bg-white' : 'bg-white/40'}`} 
          data-index={i} 
          aria-label={`Slide ${i + 1}`}
        ></button>
      ))}
    </div>
  </div>
</div>
