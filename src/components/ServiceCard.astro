---
import Icon from './Icon.astro';
import type { ServiceItem } from '../data/services';

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;
---

<article 
  class="service-card group bg-white rounded-2xl border border-slate-200/90 hover:border-emerald-300/80 shadow-2xs hover:shadow-md transition-all duration-300 flex flex-col overflow-hidden relative"
  data-id={service.id}
  data-brand={service.brand}
  data-category={service.category}
  data-price={service.price}
  data-popular={service.isPopular ? 'true' : 'false'}
  data-title={service.title.toLowerCase()}
>
  <!-- Card Image Container with Badges -->
  <div class="relative w-full aspect-16/10 sm:aspect-16/9 bg-slate-100 overflow-hidden">
    <img 
      src={service.image} 
      alt={service.title} 
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20 pointer-events-none"></div>

    <!-- Top Left Badge: Discount & Badge -->
    <div class="absolute top-2.5 left-2.5 flex flex-wrap gap-1.5 z-10">
      <span class="px-2 py-0.5 rounded-lg text-[10px] sm:text-xs font-black bg-emerald-600 text-white tracking-wide shadow-sm">
        {service.discount}
      </span>
      {service.badge && (
        <span class="px-2 py-0.5 rounded-lg text-[10px] sm:text-xs font-extrabold bg-slate-900/80 backdrop-blur-md text-amber-300 border border-amber-400/30 shadow-sm">
          {service.badge}
        </span>
      )}
    </div>

    <!-- Top Right: Turnaround Time Badge (Blinkit delivery speed motif) -->
    <div class="absolute top-2.5 right-2.5 z-10">
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-[10px] font-bold bg-white/95 backdrop-blur-md text-slate-800 shadow-sm border border-slate-200">
        <Icon name="clock" class="w-3 h-3 text-emerald-600" />
        {service.turnaround}
      </span>
    </div>

    <!-- Bottom Carousel Indicators (as drawn in wireframe `ar.jpeg`) -->
    <div class="absolute bottom-2 inset-x-0 flex justify-center items-center gap-1 z-10">
      <span class="w-1.5 h-1.5 rounded-full bg-white shadow-xs"></span>
      <span class="w-1 h-1 rounded-full bg-white/60"></span>
      <span class="w-1 h-1 rounded-full bg-white/60"></span>
      <span class="w-1 h-1 rounded-full bg-white/60"></span>
      <span class="w-1 h-1 rounded-full bg-white/60"></span>
    </div>
  </div>

  <!-- Card Body -->
  <div class="p-3.5 sm:p-4 flex-1 flex flex-col justify-between">
    <div>
      <!-- Rating & Category Tag -->
      <div class="flex items-center justify-between gap-2 text-xs mb-1">
        <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md">
          {service.categoryName}
        </span>
        <div class="flex items-center gap-1 text-slate-600 font-semibold text-[11px]">
          <Icon name="star" class="w-3 h-3 text-amber-500 fill-amber-500" />
          <span>{service.rating}</span>
          <span class="text-slate-400">({service.reviewsCount})</span>
        </div>
      </div>

      <!-- Service Title (Bold Uppercase as in wireframe) -->
      <h4 class="font-display font-black text-sm sm:text-base text-slate-900 tracking-tight leading-snug group-hover:text-emerald-700 transition">
        {service.title}
      </h4>

      <!-- Catchy Tagline (as in wireframe: "Most elegant Design; crafted as per ur idea") -->
      <p class="text-xs text-slate-600 font-normal mt-1 line-clamp-2">
        {service.tagline}
      </p>

      <!-- Key Highlights / Feature Pills -->
      <div class="flex flex-wrap gap-1 mt-2.5">
        {service.features.slice(0, 3).map((feat) => (
          <span class="inline-flex items-center gap-1 text-[10px] font-medium bg-slate-100 text-slate-700 px-1.5 py-0.5 rounded">
            <span class="w-1 h-1 rounded-full bg-emerald-500"></span>
            {feat}
          </span>
        ))}
      </div>

      <!-- "What We Provide" Expandable Details (As requested by user: "with each and everything what we provide into that serviecs must noted everything there") -->
      <div class="mt-3 pt-2.5 border-t border-slate-100">
        <button 
          type="button"
          class="details-toggle flex items-center justify-between w-full text-[11px] font-bold text-slate-700 hover:text-emerald-600 transition py-0.5"
          data-target={`details-${service.id}`}
        >
          <span class="flex items-center gap-1">
            <Icon name="sparkles" class="w-3 h-3 text-emerald-600" />
            <span>What We Provide in this Service</span>
          </span>
          <Icon name="chevron-down" class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200 chevron-icon" />
        </button>

        <div id={`details-${service.id}`} class="details-content hidden mt-2 space-y-1.5 text-[11px] text-slate-600 bg-slate-50 p-2.5 rounded-xl border border-slate-200/70">
          <p class="text-[10px] font-semibold text-slate-800 uppercase tracking-wider mb-1">Full Scope of Deliverables:</p>
          <ul class="space-y-1">
            {service.deliverables.map((item) => (
              <li class="flex items-start gap-1.5 text-slate-700">
                <Icon name="check" class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" />
                <span class="leading-tight">{item}</span>
              </li>
            ))}
          </ul>

          {service.techStack && (
            <div class="mt-2 pt-2 border-t border-slate-200/80 flex items-center gap-1 flex-wrap">
              <span class="text-[10px] font-bold text-slate-500">Tech/Tools:</span>
              {service.techStack.map((tech) => (
                <span class="text-[9px] bg-white text-slate-700 px-1.5 py-0.5 rounded border border-slate-200 font-mono">
                  {tech}
                </span>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Card Bottom Strip: Pricing & [ Book + ] Button (as drawn in wireframe) -->
    <div class="mt-4 pt-3 border-t border-slate-100 flex items-end justify-between gap-2">
      <!-- Pricing Segment -->
      <div>
        <div class="flex items-baseline gap-1.5">
          <span class="text-xs text-slate-400 line-through font-medium">
            ₹{service.originalPrice.toLocaleString('en-IN')}
          </span>
          <span class="text-base sm:text-lg font-black text-slate-900 tracking-tight font-display">
            ₹{service.price.toLocaleString('en-IN')}
          </span>
          <span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-1 py-0.2 rounded">
            ({service.discount} ↓)
          </span>
        </div>
        <div class="text-[10px] font-semibold text-emerald-700">
          {service.priceLabel}
        </div>
      </div>

      <!-- Action Button: [ Book + ] / Counter (Blinkit style) -->
      <div class="service-action-slot" data-id={service.id}>
        <!-- Initial [ Book + ] Button -->
        <button 
          class="book-service-btn inline-flex items-center justify-center gap-1 px-3 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-black bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white transition-all shadow-sm shadow-emerald-600/20 border border-emerald-600"
          data-id={service.id}
          data-title={service.title}
          data-price={service.price}
          aria-label={`Book ${service.title}`}
        >
          <span>Book</span>
          <Icon name="plus" class="w-3.5 h-3.5" />
        </button>

        <!-- Counter Buttons (hidden until item added) -->
        <div class="service-counter hidden items-center bg-emerald-50 border border-emerald-500 rounded-xl p-0.5 text-emerald-800 font-bold text-xs sm:text-sm">
          <button class="qty-btn-minus w-7 h-7 flex items-center justify-center rounded-lg hover:bg-emerald-100 text-emerald-800 active:scale-90 transition" data-id={service.id}>
            <Icon name="minus" class="w-3.5 h-3.5" />
          </button>
          <span class="qty-display w-6 text-center font-black text-slate-900">1</span>
          <button class="qty-btn-plus w-7 h-7 flex items-center justify-center rounded-lg hover:bg-emerald-100 text-emerald-800 active:scale-90 transition" data-id={service.id}>
            <Icon name="plus" class="w-3.5 h-3.5" />
          </button>
        </div>
      </div>
    </div>
  </div>
</article>
